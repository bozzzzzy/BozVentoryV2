DISCORD_TOKEN=...                       # from Discord developer portal
ANTHROPIC_API_KEY=...                   # from console.anthropic.com
GROQ_API_KEY=...                        # optional; from console.groq.com — enables voice memos
DISCORD_USER_ID=...                     # bot ignores all other users
DISCORD_CHANNEL_ID=...                  # bot ignores all other channels
GOOGLE_SHEETS_ID=...                    # from the sheet URL
GOOGLE_SERVICE_ACCOUNT_PATH=./creds.json  # path to service account JSON
DIGEST_HOUR=9                           # 0-23, local time
STALE_DAYS=30
CONFIRMATION_TIMEOUT_MINUTES=60
